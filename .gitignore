# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Virtual environments
venv/
.venv/
env/
ENV/

# Local databases and logs
*.db
*.sqlite
*.sqlite3
*.log

# Environment variables & secrets
.env
.env.*
!.env.example

# IDE / Editor configuration
.idea/
.vscode/
*.swp
*.swo

# Agent transcripts. Tach reads these; committing one would publish a session.
.aider*
.claude/
.cursor/
.continue/
.openclaw/

# Build and tooling
node_modules/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editor and merge leftovers
*.bak
*.orig
*.rej
*.swp

# SQLite sidecars (the *.db rule above misses these)
*.db-wal
*.db-shm
*.sqlite-journal
